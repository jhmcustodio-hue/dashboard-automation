# Databricks SQL Warehouse
DATABRICKS_SERVER_HOSTNAME=adb-xxxxxxxxxxxx.xx.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_WAREHOUSE_NAME=warehouse-principal
DATABRICKS_TOKEN=

# Opcional — mapeamento JSON de múltiplos warehouses (nome -> http_path). Quando definida,
# tem prioridade sobre DATABRICKS_WAREHOUSE_NAME/DATABRICKS_HTTP_PATH.
# Exemplo: {"principal": "/sql/1.0/warehouses/abc123", "vendas": "/sql/1.0/warehouses/def456"}
DATABRICKS_WAREHOUSES=

# Geração (Anthropic) — NÃO preencher para dashboards com dado sensível
# até compliance/segurança aprovar (ver "Gate de compliance" no README).
ANTHROPIC_API_KEY=

# Publicação — Azure Blob
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=dashboards
# Opcional — usada pra notificações conterem um link clicável em vez de um caminho de storage
AZURE_STORAGE_PUBLIC_BASE_URL=

# Notificação — email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
