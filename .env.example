# Databricks SQL Warehouse
DATABRICKS_SERVER_HOSTNAME=adb-xxxxxxxxxxxx.xx.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_WAREHOUSE_NAME=warehouse-principal
DATABRICKS_TOKEN=

# Geração (Anthropic) — NÃO preencher para dashboards com dado sensível
# até compliance/segurança aprovar (ver "Gate de compliance" no README).
ANTHROPIC_API_KEY=

# Publicação — Azure Blob
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=dashboards

# Notificação — email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
